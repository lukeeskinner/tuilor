{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "pages"],
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "name": {"type": "string", "minLength": 1},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "components"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "components": {"type": "array", "minItems": 1, "items": {"anyOf": [{"$ref": "#/$defs/text"}, {"$ref": "#/$defs/form"}]}}
      }
    },
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {"type": {"type": "string", "enum": ["text"]}, "text": {"type": "string", "minLength": 1}}
    },
    "form": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "id", "title", "fields", "action"],
      "properties": {
        "type": {"type": "string", "enum": ["form"]},
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "action": {"$ref": "#/$defs/action"}
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["text_input"]},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "bindings"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["parameter", "field"],
      "properties": {"parameter": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1}}
    }
  }
}
