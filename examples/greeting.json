{
  "version": 1,
  "name": "Greeting App",
  "pages": [
    {
      "id": "home",
      "title": "Greeting",
      "components": [
        {"type": "text", "text": "Enter your name to receive a greeting."},
        {
          "type": "form",
          "id": "greeting",
          "title": "Say hello",
          "fields": [{"id": "person", "type": "text_input", "label": "Your name"}],
          "action": {"tool": "greet", "bindings": [{"parameter": "name", "field": "person"}]}
        }
      ]
    }
  ]
}
