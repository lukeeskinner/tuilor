{
  "version": 2,
  "name": "Todo List",
  "collections": [
    {
      "id": "tasks",
      "fields": [
        {
          "id": "title",
          "type": "text"
        },
        {
          "id": "completed",
          "type": "boolean"
        }
      ]
    }
  ],
  "pages": [
    {
      "id": "home",
      "title": "My tasks",
      "components": [
        {
          "type": "form",
          "id": "add",
          "title": "Add a task",
          "fields": [
            {
              "id": "title",
              "type": "text_input",
              "label": "Task title"
            }
          ],
          "local_action": {
            "kind": "insert",
            "collection": "tasks",
            "bindings": [
              {
                "parameter": "title",
                "field": "title"
              }
            ],
            "values": []
          }
        },
        {
          "type": "list",
          "id": "tasks",
          "title": "Tasks",
          "collection": "tasks",
          "label_field": "title",
          "status_field": "completed",
          "actions": [
            {
              "kind": "update",
              "collection": "tasks",
              "bindings": [],
              "values": [
                {
                  "field": "completed",
                  "value": true
                }
              ]
            },
            {
              "kind": "delete",
              "collection": "tasks",
              "bindings": [],
              "values": []
            }
          ]
        }
      ]
    }
  ]
}
